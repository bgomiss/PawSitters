rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isUser(uid) { return signedIn() && request.auth.uid == uid; }

    // User profiles. `emailVerified: true` is only accepted from a token whose
    // email Firebase Auth has actually verified, so the badge can't be faked.
    function emailVerifiedFieldIsHonest() {
      return !('emailVerified' in request.resource.data)
        || request.resource.data.emailVerified != true
        || request.auth.token.email_verified == true;
    }
    match /sitters/{uid} {
      allow read: if signedIn();
      allow write: if isUser(uid) && emailVerifiedFieldIsHonest();
    }
    match /owners/{uid} {
      allow read: if signedIn();
      allow write: if isUser(uid) && emailVerifiedFieldIsHonest();
    }

    // Push notification tokens for each user's devices (read by Cloud Functions).
    match /fcmTokens/{uid} {
      allow read, write: if isUser(uid);
    }

    // Listings: anyone signed in can browse, only the author can change them
    match /ownersListings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
    match /sittersListings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Applications to listings; the ID is "{listingId}_{applicantId}".
    // Only the applicant and the listing owner can see one. The owner may accept or
    // decline a pending application; the applicant may withdraw it and re-apply later.
    match /applications/{applicationId} {
      allow read: if signedIn()
        && (resource.data.applicantId == request.auth.uid || resource.data.listingOwnerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.listingOwnerId != request.auth.uid
        && request.resource.data.status == 'pending'
        && applicationId == request.resource.data.listingId + '_' + request.auth.uid;
      allow update: if signedIn() && (
        (resource.data.listingOwnerId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']))
        || (resource.data.applicantId == request.auth.uid
          && request.resource.data.applicantId == request.auth.uid
          && request.resource.data.listingOwnerId == resource.data.listingOwnerId
          && ((resource.data.status == 'pending' && request.resource.data.status == 'withdrawn')
            || (resource.data.status == 'withdrawn' && request.resource.data.status == 'pending')))
      );
    }

    // Reviews; the ID is "{applicationId}_{reviewerId}" so each party reviews a stay once.
    // Only the two people of an accepted application can review each other. Reviews are
    // readable by every signed-in user and can't be edited or deleted afterwards.
    function reviewMatchesApplication(app) {
      return app.status == 'accepted'
        && ((app.applicantId == request.auth.uid && request.resource.data.revieweeId == app.listingOwnerId)
          || (app.listingOwnerId == request.auth.uid && request.resource.data.revieweeId == app.applicantId));
    }
    match /reviews/{reviewId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.reviewerId == request.auth.uid
        && reviewId == request.resource.data.applicationId + '_' + request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.comment is string && request.resource.data.comment.size() <= 1000
        && exists(/databases/$(database)/documents/applications/$(request.resource.data.applicationId))
        && reviewMatchesApplication(get(/databases/$(database)/documents/applications/$(request.resource.data.applicationId)).data);
      allow update, delete: if false;
    }

    // Per-user favorites: favorites/{uid} { listingIds: [...] }
    match /favorites/{uid} {
      allow read, write: if isUser(uid);
    }

    // Messages are written to both messages/{sender}/{receiver} and messages/{receiver}/{sender}
    match /messages/{ownerId}/{otherId}/{messageId} {
      allow read: if isUser(ownerId);
      allow create: if signedIn()
        && request.resource.data.senderId == request.auth.uid
        && (request.auth.uid == ownerId || request.auth.uid == otherId);
    }
    match /recent_messages/{ownerId}/messages/{otherId} {
      allow read: if isUser(ownerId);
      allow write: if isUser(ownerId) || isUser(otherId);
    }
  }
}
